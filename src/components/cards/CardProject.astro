---
import CardTechnology from "./CardTechnology.astro";

const { name, description, link, repositories, image, technologies } =
  Astro.props;

const repoLabel = (repo: string) =>
  repo.includes("frontend")
    ? "Frontend"
    : repo.includes("backend")
      ? "Backend"
      : "Código";
---

<article
  class="group flex flex-col overflow-hidden rounded-xl border border-border-subtle bg-surface transition-colors duration-300 hover:border-primary"
>
  <div class="relative flex flex-1 flex-col gap-4 p-6">
    <div>
      <h3 class="font-headline-md text-headline-md text-primary mb-2">
        {name}
      </h3>
      <p class="font-body-md text-body-md text-muted-foreground line-clamp-3">
        {description}
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {
        technologies.map((technology: string) => (
          <CardTechnology name={technology} />
        ))
      }
    </div>

    {/* Vista previa: aparece sobre el contenido al hacer hover, de desenfocada a nítida */}
    <img
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top opacity-0 blur-md scale-110 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:blur-none group-hover:scale-100"
      src={image}
      alt={`Vista previa de ${name}`}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-border-subtle px-6 py-4"
  >
    {
      link ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 rounded-lg bg-primary px-3 py-1.5 font-label-md text-label-md text-on-primary transition-colors hover:bg-primary-container"
        >
          Vista previa
          <span class="material-symbols-outlined text-[18px]!">
            arrow_outward
          </span>
        </a>
      ) : (
        <span class="font-label-md text-label-md text-muted-foreground">
          En desarrollo
        </span>
      )
    }
    <div class="flex items-center gap-3">
      {
        repositories.map((repo: string) => (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-label-sm text-label-sm text-muted-foreground transition-colors hover:text-primary"
          >
            <span class="material-symbols-outlined text-[16px]!">code</span>
            {repoLabel(repo)}
          </a>
        ))
      }
    </div>
  </div>
</article>
